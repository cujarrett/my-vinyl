{
  "name": "my-vinyl",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "ci": "npm run format:check && npm run lint && npm test"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@types/jest": "~30.0.0",
    "@typescript-eslint/eslint-plugin": "~8.68.0",
    "@typescript-eslint/parser": "~8.68.0",
    "eslint": "~10.9.1",
    "jest": "~30.5.0",
    "jest-environment-jsdom": "~30.5.0",
    "jest-preset-angular": "~17.0.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "zone.js": "~0.16.2"
  }
}
